{
  "name": "cdr-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CDR: Privacy Infra for AI — threshold-encrypted data vaults on Story L1. Reference frontend with five end-to-end demos.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piplabs/cdr-demo.git"
  },
  "homepage": "https://github.com/piplabs/cdr-demo#readme",
  "bugs": {
    "url": "https://github.com/piplabs/cdr-demo/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "cd cdr-sdk && pnpm install --frozen-lockfile && pnpm build --filter=@piplabs/cdr-contracts --filter=@piplabs/cdr-crypto --filter=@piplabs/cdr-sdk && cd .. && node scripts/copy-wasm.js && next build",
    "start": "next start",
    "postinstall": "node scripts/copy-wasm.js"
  },
  "dependencies": {
    "@noble/curves": "^1.6",
    "@piplabs/cdr-contracts": "link:./cdr-sdk/packages/contracts",
    "@piplabs/cdr-crypto": "link:./cdr-sdk/packages/crypto",
    "@piplabs/cdr-sdk": "link:./cdr-sdk/packages/sdk",
    "@privy-io/react-auth": "^2",
    "@storacha/client": "^2.1.3",
    "next": "^15.5.15",
    "openai": "^6.33.0",
    "react": "^18.3",
    "react-dom": "^18.3",
    "viem": "^2.21"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "postcss": "^8",
    "tailwindcss": "^3.4",
    "typescript": "^5.5"
  },
  "pnpm": {
    "overrides": {
      "@piplabs/cdr-contracts": "link:./cdr-sdk/packages/contracts",
      "@piplabs/cdr-crypto": "link:./cdr-sdk/packages/crypto",
      "protobufjs@<7.5.5": ">=7.5.5",
      "defu@<6.1.5": ">=6.1.5",
      "picomatch@<2.3.2": ">=2.3.2 <3",
      "picomatch@<4.0.4": "^4.0.4",
      "axios@<1.15.0": ">=1.15.0",
      "follow-redirects@<1.16.0": ">=1.16.0",
      "brace-expansion@<1.1.13": ">=1.1.13"
    }
  }
}
